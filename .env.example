# Host port exposed by the local translation server.
CWT_PORT=8989

# Models downloaded by the container entrypoint if missing.
CWT_MODELS=zh-Hans_en en_zh-Hans en_fr fr_en

# Set to 1 after models are downloaded if you want startup to fail without network.
CWT_OFFLINE_ONLY=0

# MTranServer version used by Docker builds.
MTRANSERVER_VERSION=4.0.33
